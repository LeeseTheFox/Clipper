+static void vaapi_direct_cache_release(struct vaapi_direct_cache *cache)
+{
+	if (!cache || --cache->refs)
+		return;
+	for (size_t i = 0; i < cache->count; ++i)
+		for (uint32_t j = 0; j < cache->imports[i].num_textures; ++j)
+			gs_texture_destroy(cache->imports[i].textures[j]);
+	av_buffer_unref(&cache->context);
+	bfree(cache);
