+
+struct vaapi_direct_surface {
+	struct vaapi_surface surface;
+	GLsync fence;
+	struct vaapi_direct_cache *cache;
+};
+
+/* A client-side wait, not a server-side glWaitSync: VA-API must not see
+ * outstanding GL writes. The encode thread waits after the render thread has
+ * submitted and flushed the fence. FFmpeg retains the frame for async encode. */
+static bool vaapi_direct_wait(struct vaapi_direct_surface *lease)
+{
+	if (!lease->fence)
+		return false;
+	GLenum result;
+	do {
+		result = glClientWaitSync(lease->fence, 0, 1000000000ULL);
+	} while (result == GL_TIMEOUT_EXPIRED);
+	return result == GL_ALREADY_SIGNALED || result == GL_CONDITION_SATISFIED;
+}
+
+static bool vaapi_direct_finish(void *opaque)
+{
+	struct vaapi_direct_surface *lease = opaque;
+	lease->fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+	glFlush();
+	return lease->fence != NULL;
+}
+
+static void vaapi_direct_release(void *opaque)
+{
+	struct vaapi_direct_surface *lease = opaque;
+	/* Also covers a failed fence allocation after rendering. */
+	if (!vaapi_direct_wait(lease))
+		glFinish();
+	if (lease->fence)
+		glDeleteSync(lease->fence);
+	vaapi_destroy_surface(&lease->surface);
+	vaapi_direct_cache_release(lease->cache);
+	bfree(lease);
+}
+
+static bool vaapi_direct_validate(struct vaapi_surface *surface, struct vaapi_import *entry, uint32_t width, uint32_t height)
+{
+	graphics_t *context = gs_get_context();
+	if (entry && context && entry->validated_context == context &&
+	    entry->validated_width == width && entry->validated_height == height)
+		return true;
+	if (entry)
+		entry->validated_context = NULL;
+	bool valid = surface->num_textures == 2;
+	gs_texture_t *previous = gs_get_render_target();
+	for (uint32_t i = 0; valid && i < 2; ++i) {
+		gs_texture_t *tex = surface->textures[i];
+		valid = gs_texture_get_width(tex) == (width >> i) &&
+			gs_texture_get_height(tex) == (height >> i) &&
+			gs_texture_get_color_format(tex) == (i ? GS_R8G8 : GS_R8);
+		if (valid) {
+			gs_set_render_target(tex, NULL);
+			valid = gs_get_render_target() == tex &&
+				glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+		}
+	}
+	gs_set_render_target(previous, NULL);
+	if (valid && entry) {
+		entry->validated_context = context;
+		entry->validated_width = width;
+		entry->validated_height = height;
+	}
+	return valid;
+}
