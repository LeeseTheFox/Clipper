+		for (size_t i = 0; i < enc->direct_cache->count; ++i) {
+			if (enc->direct_cache->imports[i].id == id) {
+				entry = &enc->direct_cache->imports[i];
+				break;
+			}
+		}
+	}
+	if (!vaapi_direct_validate(surface, entry, width, height)) {
+		vaapi_destroy_surface(surface);
+		bfree(lease);
+		goto fail;
+	}
