+		return false;
+	AVHWFramesContext *frames = (AVHWFramesContext *)enc->vaframes_ref->data;
+	if (frames->sw_format != AV_PIX_FMT_NV12 || width != (uint32_t)enc->context->width ||
+	    height != (uint32_t)enc->height || (width & 1) || (height & 1))
+		return false;
+
+	if (enc->direct_cache && enc->direct_cache->context->data != enc->vaframes_ref->data) {
+		vaapi_direct_cache_release(enc->direct_cache);
+		enc->direct_cache = NULL;
+	}
+	if (!enc->direct_cache) {
+		enc->direct_cache = bzalloc(sizeof(*enc->direct_cache));
+		enc->direct_cache->refs = 1;
+		enc->direct_cache->context = av_buffer_ref(enc->vaframes_ref);
+		if (!enc->direct_cache->context)
