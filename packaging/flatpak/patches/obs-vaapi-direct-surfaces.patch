+/* Reserve an ordinary queue slot before acquiring a lease: the direct path
+ * cannot grow the queue or bypass existing backpressure. No strong encoder
+ * reference is stored in the queue (which would create a teardown cycle). */
+static bool render_direct_surface(struct obs_core_video_mix *video, gs_texture_t *texture)
+{
+	const struct video_output_info *info = video_output_get_info(video->video);
+	if (!video->gpu_conversion || info->format != VIDEO_FORMAT_NV12 ||
+	    !video->vframe_info_buffer_gpu.size)
+		return false;
+
+	bool rendered = false;
+	pthread_mutex_lock(&video->gpu_encoder_mutex);
+	struct obs_vframe_info *vframe = deque_data(&video->vframe_info_buffer_gpu, 0);
+	if (video->gpu_encoders.num != 1 || vframe->count != 1)
+		goto done;
+	obs_encoder_t *encoder = video->gpu_encoders.array[0];
+	if (!encoder->info.acquire_surface || !encoder->info.encode_texture2)
+		goto done;
+	if (!video->gpu_encoder_avail_queue.size && !grow_gpu_encoding_texture_pool(video))
+		goto done;
+
+	struct encoder_surface surface = {0};
+	if (!encoder->info.acquire_surface(encoder->context.data, info->width, info->height, &surface))
+		goto done;
+
+	render_convert_texture(video, surface.tex, texture);
+	gs_set_render_target(NULL, NULL);
+	if (!surface.finish(surface.opaque)) {
+		surface.release(surface.opaque);
+		goto done;
+	}
+
+	struct obs_tex_frame tf;
+	deque_pop_front(&video->gpu_encoder_avail_queue, &tf, sizeof(tf));
+	tf.surface = surface;
+	tf.surface_owner = obs_encoder_get_weak_encoder(encoder);
+	tf.count = 1;
+	tf.timestamp = vframe->timestamp;
+	struct obs_vframe_info consumed;
+	deque_pop_front(&video->vframe_info_buffer_gpu, &consumed, sizeof(consumed));
+	deque_push_back(&video->gpu_encoder_queue, &tf, sizeof(tf));
+	os_sem_post(video->gpu_encode_semaphore);
+	rendered = true;
+done:
+	pthread_mutex_unlock(&video->gpu_encoder_mutex);
+	return rendered;
+}
