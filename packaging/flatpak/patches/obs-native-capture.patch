+/* Preview requests can materialize the scene after a bypassed video tick.
+ * Preserve the caller's graphics state and never expose the stale RGB target. */
+void obs_ensure_mix_texture(struct obs_core_video_mix *video)
+{
+	if (!video || !video->clipper_native_pending || video->texture_rendered || !video->render_texture)
+		return;
+	/* Source ticks can take their own mutex before entering graphics. A caller
+	 * must queue its preview on OBS_TASK_GRAPHICS before taking graphics. */
+	if (!obs_in_task_thread(OBS_TASK_GRAPHICS))
+		return;
+	gs_texture_t *target = gs_get_render_target();
+	gs_zstencil_t *zs = gs_get_zstencil_target();
+	enum gs_color_space space = gs_get_color_space();
+	bool srgb = gs_framebuffer_srgb_enabled();
+	gs_viewport_push();
+	gs_projection_push();
+	gs_matrix_push();
+	gs_blend_state_push();
+	gs_matrix_identity();
+	gs_reset_blend_state();
+	render_main_texture(video);
+	gs_set_render_target_with_color_space(target, zs, space);
+	gs_enable_framebuffer_srgb(srgb);
+	gs_blend_state_pop();
+	gs_matrix_pop();
+	gs_projection_pop();
+	gs_viewport_pop();
+}
