+/* Return a strong reference only for an identity, single-item scene. Pending
+ * transforms deliberately fall back so normal rendering updates scene state. */
+obs_source_t *obs_scene_native_capture(obs_source_t *source, uint32_t width, uint32_t height)
+{
+	obs_scene_t *scene = obs_scene_from_source(source);
+	if (!scene || scene->is_group || !obs_source_enabled(source) || obs_source_removed(source) ||
+	    obs_source_filter_count(source))
+		return NULL;
+	obs_source_t *capture = NULL;
+	video_lock(scene);
+	struct obs_scene_item *item = scene->first_item;
+	if (!item || item->next || !item->user_visible || !item->visible || item->removed ||
+	    item->is_group || item->is_scene || item->show_transition || item->hide_transition ||
+	    os_atomic_load_bool(&item->update_transform) || os_atomic_load_long(&item->defer_update) ||
+	    source_size_changed(item) || scene->last_width != width || scene->last_height != height ||
+	    crop_enabled(&item->crop) || crop_enabled(&item->bounds_crop) || item_texture_enabled(item) ||
+	    !default_blending_enabled(item))
+		goto done;
+	struct matrix4 identity;
+	matrix4_identity(&identity);
+	/* Numeric equality accepts signed zero, but no subpixel transforms. */
+	float actual[16], expected[16];
+	memcpy(actual, &item->draw_transform, sizeof(actual));
+	memcpy(expected, &identity, sizeof(expected));
+	for (size_t i = 0; i < 16; ++i)
+		if (actual[i] != expected[i])
+			goto done;
+	source = item->source;
+	if (!obs_source_enabled(source) || obs_source_removed(source) || obs_source_filter_count(source) ||
+	    obs_source_get_width(source) != width || obs_source_get_height(source) != height ||
+	    strcmp(obs_source_get_id(source), "vkcapture-source") != 0)
+		goto done;
+	capture = obs_source_get_ref(source);
+done:
+	video_unlock(scene);
+	return capture;
+}
