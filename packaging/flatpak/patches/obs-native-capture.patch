+/* Called with channels_mutex held. Audio-only output channels do not draw. */
+static bool native_capture_single_video_channel(struct obs_view *view)
+{
+	for (size_t i = 1; i < MAX_CHANNELS; ++i)
+		if (view->channels[i] && (obs_source_get_output_flags(view->channels[i]) & OBS_SOURCE_VIDEO))
+			return false;
+	return view->channels[0] != NULL;
+}
+
+static bool render_native_capture(struct obs_core_video_mix *video)
+{
+	const char *setting = getenv("CLIPPER_NATIVE_CAPTURE");
+	const struct video_output_info *info = video_output_get_info(video->video);
+	if ((setting && strcmp(setting, "0") == 0) || !video_output_matches_base_resolution(video) ||
+	    info->format != VIDEO_FORMAT_NV12 || info->colorspace != VIDEO_CS_709 ||
+	    info->range != VIDEO_RANGE_FULL || video->render_space != GS_CS_SRGB ||
+	    gs_get_device_type() != GS_DEVICE_OPENGL || obs->video.mixes.num != 1)
+		return false;
+	pthread_mutex_lock(&obs->data.draw_callbacks_mutex);
+	bool callbacks = obs->data.draw_callbacks.num || obs->data.rendered_callbacks.num;
+	pthread_mutex_unlock(&obs->data.draw_callbacks_mutex);
+	pthread_mutex_lock(&obs->data.displays_mutex);
+	bool displays = obs->data.first_display != NULL;
+	pthread_mutex_unlock(&obs->data.displays_mutex);
+	if (callbacks || displays)
+		return false;
+
+	obs_source_t *scene = NULL;
+	pthread_mutex_lock(&video->view->channels_mutex);
+	if (native_capture_single_video_channel(video->view))
+		scene = obs_source_get_ref(video->view->channels[0]);
+	pthread_mutex_unlock(&video->view->channels_mutex);
+	if (!scene)
+		return false;
+	obs_source_t *source = obs_scene_native_capture(scene, info->width, info->height);
+	obs_source_release(scene);
+	if (!source)
+		return false;
+
+	calldata_t cd;
+	calldata_init(&cd);
+	bool rendered = false;
+	if (proc_handler_call(obs_source_get_proc_handler(source), "clipper_native_texture", &cd)) {
+		gs_texture_t *texture = calldata_ptr(&cd, "texture");
+		if (texture && gs_texture_get_width(texture) == info->width &&
+		    gs_texture_get_height(texture) == info->height) {
+			video->clipper_native_flip = calldata_bool(&cd, "flip");
+			rendered = render_direct_surface(video, texture);
+			video->clipper_native_flip = false;
+		}
+	}
+	calldata_free(&cd);
+	obs_source_release(source);
+	if (rendered) {
+		video->texture_rendered = false;
+		video->clipper_native_pending = true;
+		if (!video->clipper_native_frames++)
+			blog(LOG_INFO, "Clipper native capture: bypassing RGB scene render");
+	}
+	return rendered;
+}
