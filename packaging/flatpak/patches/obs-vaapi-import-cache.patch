+/* Graphics context must be held. Retain the HW context, NOT AVFrame leases:
+ * FFmpeg's internal AVBufferPool retains surface allocations until uninit;
+ * av_hwframe_get_buffer alone decides when an encoder-held lease is reusable.
+ * This cache is private to one immutable frames context. */
+static void vaapi_clear_imports(struct vaapi_encoder *enc)
+{
+	for (size_t i = 0; i < enc->num_imports; ++i) {
+		for (uint32_t j = 0; j < enc->imports[i].num_textures; ++j)
+			gs_texture_destroy(enc->imports[i].textures[j]);
+	}
+	enc->num_imports = 0;
+	av_buffer_unref(&enc->import_context);
+}
