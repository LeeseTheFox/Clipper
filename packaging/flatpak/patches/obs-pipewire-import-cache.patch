 /* auxiliary methods */
 
+/* Called with the graphics lock held, like processing and rendering. */
+static void clear_frame_sync(obs_pipewire_stream *s)
+{
+#if PW_CHECK_VERSION(1, 2, 0)
+	if (s->sync.release_syncobj_fd != -1 && !s->sync.release_point_will_signal)
+		gs_sync_signal_syncobj_timeline_point(s->sync.release_syncobj_fd, s->sync.release_point);
+#endif
+	g_clear_fd(&s->sync.acquire_syncobj_fd, NULL);
+	g_clear_fd(&s->sync.release_syncobj_fd, NULL);
+	s->sync.set = false;
+}
+
+static void clear_current_texture(obs_pipewire_stream *s)
+{
+	if (!s->texture_imported)
+		gs_texture_destroy(s->texture);
+	s->texture = NULL;
+	s->texture_imported = false;
+}
+
+static void clear_imports(obs_pipewire_stream *s)
+{
+	clear_frame_sync(s);
+	clear_current_texture(s);
+	while (s->imports) {
+		struct dmabuf_import *entry = s->imports;
+		s->imports = entry->next;
+		gs_texture_destroy(entry->texture);
+		bfree(entry);
+	}
+}
+
+static void on_remove_buffer_cb(void *data, struct pw_buffer *buffer)
+{
+	obs_pipewire_stream *s = data;
+	obs_enter_graphics();
+	for (struct dmabuf_import **link = &s->imports; *link; link = &(*link)->next) {
+		struct dmabuf_import *entry = *link;
+		if (entry->buffer != buffer)
+			continue;
+		if (entry->texture && s->texture == entry->texture) {
+			clear_frame_sync(s);
+			clear_current_texture(s);
+		}
+		*link = entry->next;
+		gs_texture_destroy(entry->texture);
+		bfree(entry);
+		break;
+	}
+	obs_leave_graphics();
+}
+
+static gs_texture_t *import_buffer(obs_pipewire_stream *s, struct pw_buffer *buffer, uint32_t drm_format,
+				   uint32_t planes, const int *fds, const uint32_t *strides,
+				   const uint32_t *offsets, const uint64_t *modifiers)
+{
+	if (!planes || planes > MAX_AV_PLANES)
+		return NULL;
+
+	struct dmabuf_import *entry = s->imports;
+	while (entry && entry->buffer != buffer)
+		entry = entry->next;
+	if (!entry) {
+		entry = bzalloc(sizeof(*entry));
+		entry->buffer = buffer;
+		entry->next = s->imports;
+		s->imports = entry;
+	}
+
+	/* Chunk offsets/strides can change even while the buffer stays alive.
+	 * Format, dimensions and modifier changes clear the entire cache. */
+	if (entry->texture && (entry->planes != planes ||
+			      memcmp(entry->fds, fds, planes * sizeof(*fds)) ||
+			      memcmp(entry->strides, strides, planes * sizeof(*strides)) ||
+			      memcmp(entry->offsets, offsets, planes * sizeof(*offsets))))
+		g_clear_pointer(&entry->texture, gs_texture_destroy);
+
+	if (!entry->texture) {
+		entry->texture = gs_texture_create_from_dmabuf(s->format.info.raw.size.width,
+							     s->format.info.raw.size.height, drm_format, GS_BGRX,
+							     planes, fds, strides, offsets, modifiers);
+		entry->planes = planes;
+		memcpy(entry->fds, fds, planes * sizeof(*fds));
+		memcpy(entry->strides, strides, planes * sizeof(*strides));
+		memcpy(entry->offsets, offsets, planes * sizeof(*offsets));
+	}
+	return entry->texture;
+}
