CompileFlags:
  Add:
    # Generated by tools/configure_engine_clangd.sh from the pinned libobs
    # source used by Clipper's most recent Flatpak build.
    - -I../../.flatpak-builder/clangd-include
    # libobs uses SIMDe's SSE2 API. clangd only needs the native x86 header
    # bridge here; the Flatpak build uses the complete pinned SIMDe package.
    - -Iclangd-compat
    - -I../vendor
    # Keep these in sync with `pkg-config --cflags glib-2.0 gio-2.0` from
    # the engine Makefile so clangd can resolve GLib symbols as well.
    - -I/usr/include/glib-2.0
    - -I/usr/lib64/glib-2.0/include
    - -I/usr/lib/x86_64-linux-gnu/glib-2.0/include
    - -std=c11
